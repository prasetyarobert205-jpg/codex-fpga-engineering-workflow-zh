{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fault-case.schema.json",
  "title": "Private FPGA Fault Case",
  "type": "object",
  "required": ["schema_version", "case_id", "status", "confidentiality", "vendor", "subsystem", "normalized_error_signature", "symptom", "trigger", "root_cause", "diagnostic_path", "repair_principle", "verification", "applicability", "counterexamples", "evidence_hashes"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "case_id": {"type": "string", "pattern": "^(?:SYNTH_[A-Z0-9_.:-]+|CASE[_:-][A-Z0-9_.:-]+|P[0-9]{8,16})$"},
    "status": {"enum": ["IMPORTED", "ROOT_CAUSE_CONFIRMED", "FIX_VERIFIED", "BOARD_CONFIRMED", "REUSABLE", "REJECTED"]},
    "source_document": {"type": "string", "pattern": "\\S"},
    "source_status": {"type": "string"},
    "confidentiality": {"type": "string", "pattern": "\\S"},
    "vendor": {"type": "string", "pattern": "\\S"},
    "tool": {"type": "string"},
    "tool_version": {"type": "string"},
    "subsystem": {"type": "string", "pattern": "\\S"},
    "normalized_error_signature": {"type": "string", "pattern": "\\S"},
    "symptom": {"type": "string", "pattern": "\\S"},
    "trigger": {"type": "string", "pattern": "\\S"},
    "root_cause": {"type": "string", "pattern": "\\S"},
    "root_cause_state": {"type": "string"},
    "diagnostic_path": {"type": "array", "items": {"type": "string"}},
    "failed_attempts": {"type": "array", "items": {"type": "string"}},
    "repair_principle": {"type": "string", "pattern": "\\S"},
    "verification": {"type": "array", "items": {"type": "string"}},
    "validation_state": {"type": "string"},
    "independent_review": {"type": "string"},
    "board_confirmation": {"type": ["string", "null"]},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "counterexamples": {"type": "array", "items": {"type": "string"}},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "domain_candidates": {"type": "array", "items": {"type": "string"}},
    "primary_owner_candidate": {"type": "string"},
    "evidence_hashes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "REUSABLE"}}
      },
      "then": {
        "required": ["source_document", "independent_review", "board_confirmation"],
        "properties": {
          "source_document": {"type": "string", "pattern": "\\S"},
          "root_cause": {"type": "string", "pattern": "\\S"},
          "repair_principle": {"type": "string", "pattern": "\\S"},
          "independent_review": {"type": "string", "pattern": "\\S"},
          "board_confirmation": {"type": "string", "pattern": "^(?!NOT_APPLICABLE$)(?:NOT_APPLICABLE:\\S.*|\\S.*)$"},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "applicability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "counterexamples": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  ],
  "additionalProperties": true
}
